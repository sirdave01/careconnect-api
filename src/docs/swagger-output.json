{
  "swagger": "2.0",
  "info": {
    "title": "CareConnect Healthcare API",
    "description": "REST API for the CareConnect Healthcare Appointment and Patient Management System.\n\n## Authentication\nCareConnect uses Passport.js + Google OAuth (session cookie).\n\n1. Visit `/api/auth/google` in the browser (do **not** use Try it out).\n2. Sign in with Google.\n3. You will be redirected back and a session cookie (`connect.sid`) is set.\n4. Protected endpoints can now be tested in Swagger UI.\n\n## Auth Endpoints\n- Google Login: `/api/auth/google`\n- Google Callback: `/api/auth/google/callback`\n- Logout: `/api/auth/logout`\n- Current User: `/api/auth/me`",
    "version": "1.0.0"
  },
  "host": "https://careconnect-api-a8af.onrender.com/",
  "basePath": "/",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "sessionAuth": {
      "type": "apiKey",
      "name": "connect.sid",
      "in": "cookie",
      "description": "Passport authentication session cookie"
    }
  },
  "paths": {
    "/": {
      "get": {
        "tags": ["System"],
        "summary": "API root",
        "responses": {
          "200": {
            "description": "API is running"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/database-check": {
      "get": {
        "tags": ["System"],
        "summary": "Database connection check",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/google": {
      "get": {
        "tags": ["Auth"],
        "summary": "Start Google OAuth login",
        "description": "Redirects the browser to Google. Do NOT use 'Try it out' – open this URL in a new browser tab.",
        "responses": {
          "302": {
            "description": "Redirect to Google"
          }
        }
      }
    },
    "/api/auth/google/callback": {
      "get": {
        "tags": ["Auth"],
        "summary": "Google OAuth callback",
        "description": "Handled automatically by Passport after Google login.",
        "responses": {
          "302": {
            "description": "Redirect after successful login"
          }
        }
      }
    },
    "/api/auth/logout": {
      "get": {
        "tags": ["Auth"],
        "summary": "Logout",
        "responses": {
          "200": {
            "description": "Logged out successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get current authenticated user",
        "responses": {
          "200": {
            "description": "Authenticated user data"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },

    "/api/users/": {
      "get": {
        "tags": ["Users"],
        "summary": "Get all users",
        "responses": {
          "200": {
            "description": "List of users"
          }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Create a new user (mainly for testing)",
        "description": "Normally users are created by Google OAuth. Use this only for local testing.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/User"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "User created"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "tags": ["Users"],
        "summary": "Get a single user",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "User found"
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Update a user",
        "security": [{ "sessionAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/User"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User updated"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Delete a user",
        "security": [{ "sessionAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "User deleted"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },

